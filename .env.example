# Copy to .env for local runs. Never commit .env.
PUBLIC_URL=http://localhost:8080
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
TOKEN_KEY=
ALLOWED_EMAILS=wajahatzyppia4@gmail.com
MCC_ID=347-642-6639
# Optional: only allow these accounts (comma separated). Empty = all you can access.
ALLOWED_CUSTOMER_IDS=
# Budget/bid increases above this percent need an extra confirmation. Default 50.
MAX_INCREASE_PCT=50
# People who can sign in but only read (comma separated). They must also be in ALLOWED_EMAILS.
READ_ONLY_EMAILS=
# Max total daily budget of enabled campaigns per account, e.g. 399-355-6480=100,123-456-7890=50
SPEND_LIMITS=
# Free local rank tracker: Google Maps Platform API key restricted to Places API (New). Optional.
PLACES_API_KEY=

# "ads" (default) = Zyppia Google Ads connector. "gmb" = the separate Zyppia GMB connector (Business Profile + rank tracker).
CONNECTOR=ads
